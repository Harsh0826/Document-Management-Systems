# ---------------------------------------------------------------------------
# DMS server configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
# Number of trusted reverse proxies (set to 1 behind an AWS ALB)
TRUST_PROXY=0
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database (development only).
# With docker compose: postgres://dms:dms_dev_password@localhost:5432/dms
DATABASE_URL=
DATABASE_SSL=false
PGLITE_DATA_DIR=./.data/pglite

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-dev-only-jwt-secret-please-replace-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
INVITE_TTL_HOURS=72
# A sign-in ends after this many days even if the refresh token keeps rotating.
SESSION_MAX_DAYS=30
# Roles that must use two-step sign-in (TOTP). Production default: admin.
# Leave empty in development to make it optional (people can still turn it on under My account).
MFA_REQUIRED_ROLES=
# 32 random bytes, base64 — encrypts MFA secrets at rest. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Max preview/download links per user per hour (exfiltration guard).
DOWNLOADS_PER_HOUR=200

# --- File storage -------------------------------------------------------------
# local = development only (files on disk, HMAC-signed expiring URLs); s3 = production
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
FILE_URL_SECRET=change-me-dev-only-file-url-secret-please-replace-0123
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=25

# S3 (private bucket). For MinIO from docker-compose:
#   STORAGE_DRIVER=s3  S3_BUCKET=dms-documents  S3_ENDPOINT=http://localhost:9000  S3_FORCE_PATH_STYLE=true
#   AWS_ACCESS_KEY_ID=dms-minio  AWS_SECRET_ACCESS_KEY=dms-minio-secret
AWS_REGION=us-east-1
S3_BUCKET=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_KMS_KEY_ID=

# --- Jobs ---------------------------------------------------------------------
RUN_JOBS=true
EXPIRY_JOB_INTERVAL_MINUTES=60

# --- Bootstrap ------------------------------------------------------------------
# First administrator (created only when no users exist).
SEED_ADMIN_EMAIL=admin@dms.local
SEED_ADMIN_PASSWORD=Admin@12345
# Creates employee@dms.local and four empty starter folders (ignored in production). No documents.
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo@12345
